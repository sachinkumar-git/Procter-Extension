{
  "name": "exam-guard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CodeWallah Exam Guard monorepo",
  "engines": {
    "node": "^22.12.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/extension",
    "apps/admin"
  ],
  "scripts": {
    "build:shared": "npm run build -w @exam-guard/shared",
    "build:agent": "node scripts/agent.mjs build",
    "test:agent": "node scripts/agent.mjs test",
    "publish:agent": "node scripts/agent.mjs publish",
    "build": "npm run build --workspaces --if-present && npm run build:agent",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present && npm run test:agent",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
