# Copy to .env for local development. Never commit .env.

# API (Phase 2) - server-side only
API_PORT=3000
NODE_ENV=development
# Example: postgres://user:password@localhost:5432/exam_guard
DATABASE_URL=
SESSION_TOKEN_TTL_SECONDS=14400
ADMIN_TOKEN_TTL_SECONDS=28800
# Number of reverse proxies in front of the API (1 when behind a TLS proxy).
TRUST_PROXY_HOPS=0
# Comma-separated: the dashboard origin and chrome-extension://<extension-id>.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Limits. Client limits are per token; start limits are per IP and sized for
# a whole lab behind one public address.
RATE_LIMIT_CLIENT_PER_MINUTE=240
RATE_LIMIT_SESSION_START_PER_MINUTE=3000
RATE_LIMIT_ADMIN_LOGIN_PER_15_MINUTES=30

# Monitoring and review thresholds; shown in the dashboard and CSV.
HEARTBEAT_GRACE_SECONDS=90
REVIEW_WINDOW_MINUTES=10
REVIEW_HIGH_FOCUS_LOSSES=3
REVIEW_HIGH_FULLSCREEN_EXITS=2
REVIEW_HIGH_EXTERNAL_APPS=2

# Built into the extension and dashboard. Public: never put secrets here.
# Must be HTTPS except for localhost.
VITE_API_BASE_URL=http://localhost:3000
VITE_REFRESH_INTERVAL_SECONDS=10
